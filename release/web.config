<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 部署配置。

  为什么要它：本包是 Next.js 的静态导出产物，首屏要加载 9 个 /_next/... 资源，
  再用 fetch() 拉 6 个 /data/*.json。少任意一个，页面就是"没有样式 + 卡在加载中"。
  IIS 默认的 MIME 映射里没有 .json、.mjs、.txt，它们会被以 application/octet-stream
  返回，浏览器拒绝执行/应用，表现出来正是"没样式"。

  ⚠️ 只用 IIS **默认就有的**配置节（staticContent / defaultDocument / security）。
     特意不写 rewrite、httpCompression 之类要装额外模块的节——URL Rewrite 没装时
     IIS 会直接报 500.21，整个站点打不开，比没有配置更糟。

  ⚠️ 本站所有资源都是**绝对路径**（/_next/...、/data/...），
  因此站点**必须部署在 IIS 站点的根路径**。
  放进 http://localhost/license-forge/ 这类子路径会全部 404——
  那种情况要从源码重新构建并设置 basePath，见 DEPLOY.md。
-->
<configuration>
  <system.webServer>

    <security>
      <requestFiltering>
        <!-- IIS 默认会隐藏以 scripts 等开头的路径段；Next 产物里没有，
             这里显式去掉，避免将来加文件时被静默挡掉 -->
        <hiddenSegments remove="scripts" />
      </requestFiltering>
    </security>

    <!-- 关键：补上 Next.js 产物需要、而 IIS 默认缺失或类型不对的 MIME。
         每个 <remove> 必须先写——已存在同名映射时不先移除，IIS 会拒绝加载整段配置。 -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />

      <remove fileExtension=".txt" />
      <mimeMap fileExtension=".txt" mimeType="text/plain; charset=utf-8" />

      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript; charset=utf-8" />

      <remove fileExtension=".map" />
      <mimeMap fileExtension=".map" mimeType="application/json; charset=utf-8" />

      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />

      <!-- IIS 默认已映射这两项；这里只补 charset，避免按错误编码解释样式与脚本 -->
      <remove fileExtension=".css" />
      <mimeMap fileExtension=".css" mimeType="text/css; charset=utf-8" />
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript; charset=utf-8" />
    </staticContent>

    <!-- 直接访问 / 时落到 index.html -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.htm" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
