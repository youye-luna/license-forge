{
  "name": "license-forge",
  "version": "0.1.2",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "description": "开源许可证选择与完整产物生成器 — 一次生成 LICENSE、NOTICE、源文件头、README 段与包管理器字段",
  "license": "GPL-3.0-or-later",
  "author": "youye-luna",
  "homepage": "https://github.com/youye-luna/license-forge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youye-luna/license-forge.git"
  },
  "bugs": {
    "url": "https://github.com/youye-luna/license-forge/issues"
  },
  "keywords": [
    "license",
    "licenses",
    "spdx",
    "scancode",
    "open-source",
    "compliance",
    "notice",
    "reuse",
    "mit",
    "gpl",
    "mulan"
  ],
  "scripts": {
    "data": "node scripts/fetch-spdx.mjs && node scripts/fetch-scancode-extra.mjs && node scripts/fetch-enrichment.mjs && node scripts/fetch-choosealicense.mjs && node scripts/write-manifest.mjs",
    "data:manifest": "node scripts/write-manifest.mjs",
    "data:check": "node scripts/write-manifest.mjs --check",
    "data:spdx": "node scripts/fetch-spdx.mjs",
    "data:scancode": "node scripts/fetch-scancode-extra.mjs",
    "data:enrich": "node scripts/fetch-enrichment.mjs",
    "data:terms": "node scripts/fetch-choosealicense.mjs",
    "data:refresh": "node scripts/fetch-spdx.mjs --refresh && node scripts/fetch-scancode-extra.mjs --refresh && node scripts/fetch-enrichment.mjs --refresh && node scripts/fetch-choosealicense.mjs --refresh",
    "audit:headers": "node scripts/audit-official-headers.mjs",
    "audit:placeholders": "node scripts/audit-placeholders.mjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "package": "node scripts/package.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
